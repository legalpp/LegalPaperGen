<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HSC Legal Studies — Paper Generator</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
:root{
  --ink:#0f0e0d;--paper:#faf8f4;--cream:#f0ebe0;--rule:#d4c9b0;--light:#e8e0d0;--muted:#7a7060;
  --mcq:#5a3e8b;--sa:#2e6b8b;--crime:#2e4a8b;--work:#2e7a4a;--world:#8b2e2e;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:var(--paper);color:var(--ink);min-height:100vh}
.shell{max-width:1060px;margin:0 auto;padding:36px 20px 80px}

/* Masthead */
.masthead{border-top:3px double var(--ink);border-bottom:3px double var(--ink);padding:16px 0 12px;margin-bottom:28px;display:flex;justify-content:space-between;align-items:flex-end}
.kicker{font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--world);margin-bottom:4px}
.masthead h1{font-family:'Playfair Display',serif;font-size:clamp(1.6rem,3.5vw,2.4rem);font-weight:900;line-height:1.05}
.masthead h1 em{font-style:italic;color:var(--world)}
.masthead-meta{font-family:'DM Mono',monospace;font-size:.6rem;color:var(--muted);text-align:right;line-height:1.9}

/* Exam details */
.exam-bar{display:grid;grid-template-columns:1fr 1fr 80px 80px 80px;gap:10px;margin-bottom:20px}
@media(max-width:620px){.exam-bar{grid-template-columns:1fr 1fr}}
.field label{display:block;font-size:.68rem;font-weight:700;color:var(--muted);margin-bottom:3px;text-transform:uppercase;letter-spacing:.04em}
.field input{width:100%;border:1.5px solid var(--rule);border-radius:4px;padding:7px 9px;font-family:'DM Sans',sans-serif;font-size:.85rem;background:white}
.field input:focus{outline:none;border-color:var(--world)}

/* Section label */
.sec-label{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--rule);padding-bottom:5px;margin-bottom:12px}

/* ── TABS ── */
.tabs{display:flex;gap:0;margin-bottom:0;border-bottom:2px solid var(--rule)}
.tab{padding:9px 18px;font-family:'DM Sans',sans-serif;font-size:.82rem;font-weight:700;border:none;background:transparent;cursor:pointer;color:var(--muted);border-bottom:3px solid transparent;margin-bottom:-2px;transition:all .15s;letter-spacing:.02em}
.tab:hover{color:var(--ink)}
.tab.active{color:var(--ink);border-bottom-color:var(--ink)}
.tab-panel{display:none;padding-top:18px}
.tab-panel.active{display:block}

/* ── Panel cards ── */
.panels{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:20px}
@media(max-width:700px){.panels{grid-template-columns:1fr}}
.panel{border:1.5px solid var(--rule);border-radius:8px;overflow:hidden;background:white}
.panel-hdr{padding:10px 13px 8px;display:flex;justify-content:space-between;align-items:flex-start}
.panel-hdr.mcq {background:#f2eefa;border-bottom:2px solid var(--mcq)}
.panel-hdr.sa  {background:#eaf3f8;border-bottom:2px solid var(--sa)}
.panel-hdr.crime{background:#edf0f8;border-bottom:2px solid var(--crime)}
.panel-hdr.work {background:#edf5f0;border-bottom:2px solid var(--work)}
.panel-hdr.world{background:#f8edee;border-bottom:2px solid var(--world)}
.panel-title{font-family:'Playfair Display',serif;font-size:.9rem;font-weight:700}
.panel-title.mcq {color:var(--mcq)}.panel-title.sa{color:var(--sa)}
.panel-title.crime{color:var(--crime)}.panel-title.work{color:var(--work)}.panel-title.world{color:var(--world)}
.panel-marks{font-family:'DM Mono',monospace;font-size:.56rem;color:var(--muted);line-height:1.7;text-align:right}
.panel-body{padding:10px 13px}

/* Pick row */
.pick-row{display:flex;gap:6px;margin-bottom:8px}
.pick-row select{flex:1;min-width:0;border:1.5px solid var(--rule);border-radius:4px;padding:5px 7px;font-family:'DM Sans',sans-serif;font-size:.74rem;background:var(--paper)}
.pick-row select:focus{outline:none}
.btn-pick{flex-shrink:0;border:none;border-radius:4px;padding:5px 9px;font-size:.72rem;font-weight:700;cursor:pointer;color:white;font-family:'DM Sans',sans-serif}
.btn-pick.mcq{background:var(--mcq)}.btn-pick.sa{background:var(--sa)}
.btn-pick.crime{background:var(--crime)}.btn-pick.work{background:var(--work)}.btn-pick.world{background:var(--world)}
.btn-pick:hover{opacity:.85}

/* Slots */
.q-slot{background:var(--cream);border:1.5px solid var(--rule);border-radius:5px;padding:8px 28px 8px 10px;margin-bottom:6px;min-height:50px;position:relative}
.slot-lbl{font-family:'DM Mono',monospace;font-size:.54rem;text-transform:uppercase;letter-spacing:.09em;margin-bottom:3px}
.slot-lbl.mcq{color:var(--mcq)}.slot-lbl.sa{color:var(--sa)}
.slot-lbl.crime{color:var(--crime)}.slot-lbl.work{color:var(--work)}.slot-lbl.world{color:var(--world)}
.slot-txt{font-size:.75rem;line-height:1.42;color:var(--ink);font-style:italic}
.slot-txt.empty{color:var(--rule);font-style:normal}
.slot-clear{position:absolute;top:6px;right:7px;background:none;border:none;color:var(--muted);font-size:.72rem;cursor:pointer}
.slot-clear:hover{color:var(--world)}
.or-div{text-align:center;font-family:'DM Mono',monospace;font-size:.56rem;color:var(--muted);margin:4px 0;letter-spacing:.1em}

/* Bank scroll */
.bank-scroll{max-height:180px;overflow-y:auto;border:1.5px solid var(--rule);border-radius:4px;margin-top:6px}
.bank-scroll::-webkit-scrollbar{width:3px}
.bank-scroll::-webkit-scrollbar-thumb{background:var(--rule);border-radius:2px}
.bank-item{padding:6px 9px;border-bottom:1px solid var(--light);cursor:pointer;font-size:.72rem;line-height:1.36;transition:background .1s}
.bank-item:last-child{border-bottom:none}
.bank-item:hover{background:var(--cream)}
.bank-item.taken{opacity:.28;cursor:default;pointer-events:none}
.bank-cat{font-family:'DM Mono',monospace;font-size:.51rem;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1px}
.bank-cat.mcq{color:var(--mcq)}.bank-cat.sa{color:var(--sa)}
.bank-cat.crime{color:var(--crime)}.bank-cat.work{color:var(--work)}.bank-cat.world{color:var(--world)}
.shuffle-btn{width:100%;margin-top:6px;padding:6px;border:1.5px solid var(--rule);border-radius:4px;background:white;font-family:'DM Sans',sans-serif;font-size:.72rem;font-weight:600;cursor:pointer;color:var(--muted);transition:all .12s}
.shuffle-btn:hover{color:var(--ink);border-color:var(--ink)}

/* MCQ two-col panel layout */
.mcq-panels{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px}
@media(max-width:600px){.mcq-panels{grid-template-columns:1fr}}

/* SA panels */
.sa-panels{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px}
@media(max-width:600px){.sa-panels{grid-template-columns:1fr}}

/* SA mark total indicator */
.sa-total{display:flex;align-items:center;gap:8px;margin-bottom:10px;padding:8px 12px;border-radius:6px;font-family:'DM Mono',monospace;font-size:.72rem;border:1.5px solid var(--rule);background:var(--cream)}
.sa-total-bar{flex:1;height:6px;background:var(--light);border-radius:3px;overflow:hidden}
.sa-total-fill{height:100%;border-radius:3px;transition:width .3s,background .3s}
.sa-total-label{white-space:nowrap;font-weight:700}

/* Bottom row */
.bottom{display:grid;grid-template-columns:1fr 200px;gap:20px;align-items:start}
@media(max-width:580px){.bottom{grid-template-columns:1fr}}

/* Preview */
.preview{background:white;border:1.5px solid var(--rule);border-radius:6px;padding:14px 16px;box-shadow:3px 3px 0 var(--light);font-size:.73rem;position:relative;overflow:hidden}
.preview::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--mcq) 20%,var(--sa) 20% 40%,var(--crime) 40% 60%,var(--work) 60% 80%,var(--world) 80%)}
.prev-title{font-family:'Playfair Display',serif;font-size:.86rem;font-weight:700;text-align:center;margin-bottom:8px;line-height:1.5}
.prev-rule{border:none;border-top:1px solid var(--rule);margin:6px 0}
.prev-sec{margin-bottom:7px}
.prev-sec-title{font-weight:700;font-size:.68rem;margin-bottom:2px}
.prev-q{font-style:italic;font-size:.7rem;line-height:1.42}
.prev-q.empty{color:var(--rule);font-style:normal}
.prev-or{font-family:'DM Mono',monospace;font-size:.55rem;color:var(--muted);text-align:center;margin:2px 0}
.prev-part{font-size:.63rem;color:var(--muted);margin-bottom:1px}

/* Generate col */
.gen-col{display:flex;flex-direction:column;gap:10px}
.btn-gen{background:var(--ink);color:var(--paper);border:none;border-radius:6px;padding:11px 14px;font-family:'DM Sans',sans-serif;font-size:.86rem;font-weight:700;cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap}
.btn-gen:hover{background:#2a2825;transform:translateY(-1px)}
.btn-gen:disabled{opacity:.35;cursor:not-allowed;transform:none}
.btn-ans{background:white;color:var(--ink);border:1.5px solid var(--rule)}
.btn-ans:hover{background:var(--cream);border-color:var(--ink);transform:translateY(-1px)}
.btn-ans:disabled{opacity:.35;cursor:not-allowed;transform:none}
.readiness{font-size:.68rem;color:var(--muted);line-height:2}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:4px;vertical-align:middle}
.dot.on{background:#22c55e}.dot.off{background:var(--light)}

/* Toast */
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(14px);background:var(--ink);color:var(--paper);padding:9px 18px;border-radius:4px;font-size:.8rem;opacity:0;transition:all .2s;pointer-events:none;z-index:999}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.toast.err{background:var(--world)}
</style>
</head>
<body>
<div class="shell">

<div class="masthead">
  <div>
    <div class="kicker">HSC Legal Studies &middot; Trial Examination</div>
    <h1>Past Paper <em>Generator</em></h1>
  </div>
  <div class="masthead-meta">Section I &middot; Multiple Choice<br>Section I &middot; Short Answer (HR)<br>Section II &middot; Crime<br>Section III &middot; Options</div>
</div>

<div class="sec-label">Exam Details</div>
<div class="exam-bar" style="margin-bottom:20px">
  <div class="field"><label>Exam Title</label><input id="examTitle" value="Trial HSC Examination"></div>
  <div class="field"><label>Subject</label><input id="subject" value="Legal Studies"></div>
  <div class="field"><label>Crime Q No.</label><input id="crimeQN" type="number" value="21" min="1" max="99"></div>
  <div class="field"><label>Workplace Q</label><input id="workQN" type="number" value="22" min="1" max="99"></div>
  <div class="field"><label>World Order Q</label><input id="worldQN" type="number" value="23" min="1" max="99"></div>
</div>

<!-- TABS -->
<div class="tabs">
  <button class="tab active" onclick="switchTab('mcq',this)">&#x25CF; Multiple Choice</button>
  <button class="tab" onclick="switchTab('sa',this)">&#x25CF; Short Answer</button>
  <button class="tab" onclick="switchTab('essays',this)">&#x25CF; Essays</button>
</div>

<!-- TAB: MCQ -->
<div class="tab-panel active" id="tab-mcq">
  <div class="mcq-panels">
    <!-- Crime MCQ -->
    <div class="panel">
      <div class="panel-hdr mcq">
        <div><div class="panel-title mcq">Crime Questions</div></div>
        <div class="panel-marks">15 questions<br>from Crime topics</div>
      </div>
      <div class="panel-body">
        <div class="pick-row">
          <select id="crimeTopicPicker"><option value="">&#x2014; Any topic &#x2014;</option></select>
          <button class="btn-pick mcq" onclick="mcqPick('crime')">&#x1f3b2; Pick</button>
        </div>
        <div id="crimeSlots"></div>
        <button class="shuffle-btn" onclick="mcqShuffle('crime')">&#x1f500; Shuffle 15</button>
        <div class="bank-scroll" id="crimeBank"></div>
      </div>
    </div>
    <!-- HR MCQ -->
    <div class="panel">
      <div class="panel-hdr mcq">
        <div><div class="panel-title mcq">Human Rights Questions</div></div>
        <div class="panel-marks">5 questions<br>from Human Rights</div>
      </div>
      <div class="panel-body">
        <div style="margin-bottom:8px;font-size:.72rem;color:var(--muted)">All 5 questions drawn from the Human Rights syllabus point.</div>
        <div id="hrSlots"></div>
        <button class="shuffle-btn" onclick="mcqShuffle('hr')">&#x1f500; Shuffle 5</button>
        <div class="bank-scroll" id="hrBank"></div>
      </div>
    </div>
  </div>
  <p style="font-size:.72rem;color:var(--muted)">Select exactly 15 Crime + 5 Human Rights questions (20 total). Click questions in the bank or use Shuffle.</p>
</div>

<!-- TAB: Short Answer -->
<div class="tab-panel" id="tab-sa">
  <div style="margin-bottom:12px">
    <div class="sa-total">
      <span class="sa-total-label" id="saTotalLabel">0 / 15 marks</span>
      <div class="sa-total-bar"><div class="sa-total-fill" id="saTotalFill" style="width:0%;background:var(--light)"></div></div>
      <span style="color:var(--muted);font-size:.68rem" id="saStatusMsg">Select 3&#x2013;5 questions totalling exactly 15 marks</span>
    </div>
  </div>
  <div class="sa-panels">
    <div class="panel">
      <div class="panel-hdr sa">
        <div><div class="panel-title sa">Human Rights</div></div>
        <div class="panel-marks">Short Answer<br>3&#x2013;5 questions &middot; 15 marks total</div>
      </div>
      <div class="panel-body">
        <div class="pick-row">
          <select id="saMarkPicker">
            <option value="">&#x2014; Any marks &#x2014;</option>
            <option value="2">2 marks</option>
            <option value="3">3 marks</option>
            <option value="4">4 marks</option>
            <option value="5">5 marks</option>
            <option value="6">6 marks</option>
            <option value="7">7 marks</option>
            <option value="8">8 marks</option>
            <option value="9">9 marks</option>
          </select>
          <button class="btn-pick sa" onclick="saPick()">&#x1f3b2; Pick</button>
        </div>
        <div id="saSlots"></div>
        <button class="shuffle-btn" onclick="saShuffle()">&#x1f500; Auto-fill to 15 marks</button>
        <div class="bank-scroll" id="saBank"></div>
      </div>
    </div>
    <div class="panel" style="background:var(--cream);border-style:dashed">
      <div class="panel-body" style="padding:16px">
        <div style="font-family:'DM Mono',monospace;font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;color:var(--sa);margin-bottom:10px">Combination hints</div>
        <div style="font-size:.72rem;color:var(--muted);line-height:1.8" id="combHints"></div>
      </div>
    </div>
  </div>
</div>

<!-- TAB: Essays -->
<div class="tab-panel" id="tab-essays">
  <div class="panels">
    <!-- Crime essay -->
    <div class="panel">
      <div class="panel-hdr crime">
        <div><div class="panel-title crime">Crime</div></div>
        <div class="panel-marks">Section II<br>15 marks &middot; 1 question</div>
      </div>
      <div class="panel-body">
        <div class="pick-row">
          <select id="crimeCat"><option value="">&#x2014; Any category &#x2014;</option></select>
          <button class="btn-pick crime" onclick="essayPick('crime')">&#x1f3b2; Pick</button>
        </div>
        <div class="q-slot"><div class="slot-lbl crime">Question</div><div class="slot-txt empty" id="crimeT0">No question selected</div><button class="slot-clear" onclick="essayClear('crime',0)">&#x2715;</button></div>
        <button class="shuffle-btn" onclick="essayShuffle('crime')">&#x1f500; Random</button>
        <div class="bank-scroll" id="crimeEssayBank"></div>
      </div>
    </div>
    <!-- Workplace essay -->
    <div class="panel">
      <div class="panel-hdr work">
        <div><div class="panel-title work">Workplace</div></div>
        <div class="panel-marks">Section III<br>25 marks &middot; 2 questions</div>
      </div>
      <div class="panel-body">
        <div class="pick-row">
          <select id="workCat"><option value="">&#x2014; Any category &#x2014;</option></select>
          <button class="btn-pick work" onclick="essayPick('work')">&#x1f3b2; Pick</button>
        </div>
        <div class="q-slot"><div class="slot-lbl work">(a)</div><div class="slot-txt empty" id="workT0">No question selected</div><button class="slot-clear" onclick="essayClear('work',0)">&#x2715;</button></div>
        <div class="or-div">&#x2014; OR &#x2014;</div>
        <div class="q-slot"><div class="slot-lbl work">(b)</div><div class="slot-txt empty" id="workT1">No question selected</div><button class="slot-clear" onclick="essayClear('work',1)">&#x2715;</button></div>
        <button class="shuffle-btn" onclick="essayShuffle('work')">&#x1f500; Shuffle 2</button>
        <div class="bank-scroll" id="workEssayBank"></div>
      </div>
    </div>
    <!-- World Order essay -->
    <div class="panel">
      <div class="panel-hdr world">
        <div><div class="panel-title world">World Order</div></div>
        <div class="panel-marks">Section III<br>25 marks &middot; 2 questions</div>
      </div>
      <div class="panel-body">
        <div class="pick-row">
          <select id="worldCat"><option value="">&#x2014; Any category &#x2014;</option></select>
          <button class="btn-pick world" onclick="essayPick('world')">&#x1f3b2; Pick</button>
        </div>
        <div class="q-slot"><div class="slot-lbl world">(a)</div><div class="slot-txt empty" id="worldT0">No question selected</div><button class="slot-clear" onclick="essayClear('world',0)">&#x2715;</button></div>
        <div class="or-div">&#x2014; OR &#x2014;</div>
        <div class="q-slot"><div class="slot-lbl world">(b)</div><div class="slot-txt empty" id="worldT1">No question selected</div><button class="slot-clear" onclick="essayClear('world',1)">&#x2715;</button></div>
        <button class="shuffle-btn" onclick="essayShuffle('world')">&#x1f500; Shuffle 2</button>
        <div class="bank-scroll" id="worldEssayBank"></div>
      </div>
    </div>
  </div>
</div>

<!-- Preview + Generate -->
<div class="bottom" style="margin-top:24px">
  <div>
    <div class="sec-label">Paper Preview</div>
    <div class="preview">
      <div class="prev-title" id="prevTitle">Trial HSC Examination<br>Legal Studies</div>
      <hr class="prev-rule">
      <div class="prev-sec">
        <div class="prev-sec-title" style="color:var(--mcq)">Section I &#x2013; Multiple Choice (20 marks)</div>
        <div class="prev-q" id="prevMCQ" style="font-style:normal;font-size:.68rem;color:var(--muted)">0 of 20 selected (0 Crime, 0 HR)</div>
      </div>
      <hr class="prev-rule">
      <div class="prev-sec">
        <div class="prev-sec-title" style="color:var(--sa)">Short Answer &#x2013; Human Rights (15 marks)</div>
        <div id="prevSA" class="prev-q empty">No questions selected</div>
      </div>
      <hr class="prev-rule">
      <div class="prev-sec">
        <div class="prev-sec-title" style="color:var(--crime)">Section II &#x2013; Crime (15 marks)</div>
        <div class="prev-q empty" id="prevCrime">No question selected</div>
      </div>
      <hr class="prev-rule">
      <div class="prev-sec">
        <div class="prev-sec-title" style="color:var(--work)">Section III &#x2013; Workplace (25 marks)</div>
        <div class="prev-part">(a)</div><div class="prev-q empty" id="prevWorkA">No question selected</div>
        <div class="prev-or">&#x2014; OR &#x2014;</div>
        <div class="prev-part">(b)</div><div class="prev-q empty" id="prevWorkB">No question selected</div>
      </div>
      <hr class="prev-rule">
      <div class="prev-sec">
        <div class="prev-sec-title" style="color:var(--world)">Section III &#x2013; World Order (25 marks)</div>
        <div class="prev-part">(a)</div><div class="prev-q empty" id="prevWorldA">No question selected</div>
        <div class="prev-or">&#x2014; OR &#x2014;</div>
        <div class="prev-part">(b)</div><div class="prev-q empty" id="prevWorldB">No question selected</div>
      </div>
      <hr class="prev-rule">
      <div style="font-family:'DM Mono',monospace;font-size:.56rem;color:var(--muted);text-align:center;letter-spacing:.08em">END OF PAPER</div>
    </div>
  </div>
  <div class="gen-col">
    <button class="btn-gen" id="genBtn" onclick="generatePaper()" disabled>&#x2193; Download Paper</button>
    <button class="btn-gen btn-ans" id="ansBtn" onclick="generateAnswers()" disabled>&#x2713; Download Answers</button>
    <a class="btn-gen btn-ans" id="sheetLink"
       href="https://docs.google.com/spreadsheets/d/1k7HrdPu1pU7_AQ424DLp5XDJC1aa0FHMaAh0ZenDt5Q/edit?usp=sharing"
       target="_blank" rel="noopener noreferrer"
       style="text-decoration:none">&#x1F4CA; Open MCQ Answer Sheet</a>
    <div class="readiness">
      <div><span class="dot off" id="dMCQ"></span>MCQ (20 questions)</div>
      <div><span class="dot off" id="dSA"></span>Short Answer (15 marks)</div>
      <div><span class="dot off" id="dCrime"></span>Crime essay</div>
      <div><span class="dot off" id="dWork"></span>Workplace (a &amp; b)</div>
      <div><span class="dot off" id="dWorld"></span>World Order (a &amp; b)</div>
    </div>
  </div>
</div>

</div><!-- /shell -->
<div class="toast" id="toast"></div>

<script>
// ── DATA ─────────────────────────────────────────────────────────────────────
