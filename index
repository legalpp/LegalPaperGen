const mcqState   = { crime: [], hr: [] };      // arrays of MCQ_DATA indices
const saState    = [];                          // array of SA_DATA indices
const essayState = { crime:[null], work:[null,null], world:[null,null] };

let CRIME_TOPICS = [...new Set(MCQ_DATA.filter(q=>q['Syllabus point']!=='Human Rights').map(q=>q['Syllabus point']))];
const ESSAY_KEY    = { crime:'Crime', work:'Workplace', world:'World Order' };
const ESSAY_SLOTS  = { crime:1, work:2, world:2 };

// ── TABS ─────────────────────────────────────────────────────────────────────
function switchTab(id, btn) {
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-'+id).classList.add('active');
}

// ── MCQ ───────────────────────────────────────────────────────────────────────
function initMCQ() {
  const sel = document.getElementById('crimeTopicPicker');
  CRIME_TOPICS.forEach(t=>{ const o=document.createElement('option'); o.value=o.textContent=t; sel.appendChild(o); });
  renderMCQSlots('crime', 15);
  renderMCQSlots('hr', 5);
  renderMCQBank('crime');
  renderMCQBank('hr');
  mcqShuffle('crime');
  mcqShuffle('hr');
}

function renderMCQSlots(sec, n) {
  const container = document.getElementById(sec+'Slots');
  const state = mcqState[sec];
  container.innerHTML = '';
  for (let i=0; i<n; i++) {
    const item = state[i] != null ? MCQ_DATA[state[i]] : null;
    const d = document.createElement('div');
    d.className = 'q-slot';
    d.innerHTML = `<div class="slot-lbl mcq">Q${i+1}</div>
      <div class="slot-txt ${item?'':'empty'}">${item ? item['Question'] : 'No question selected'}</div>
      <button class="slot-clear" onclick="mcqClearSlot('${sec}',${i})">&#x2715;</button>`;
    container.appendChild(d);
  }
}

function renderMCQBank(sec) {
  const isHR = sec === 'hr';
  const pool = MCQ_DATA.map((q,i)=>({q,i})).filter(({q})=> isHR ? q['Syllabus point']==='Human Rights' : q['Syllabus point']!=='Human Rights');
  const taken = new Set(mcqState[sec]);
  document.getElementById(sec+'Bank').innerHTML = pool.map(({q,i})=>`
    <div class="bank-item ${taken.has(i)?'taken':''}" onclick="mcqSelect('${sec}',${i})">
      <div class="bank-cat mcq">${q['Syllabus point']}</div>
      <div>${q['Question']}</div>
    </div>`).join('');
}

function mcqSelect(sec, idx) {
  const max = sec==='crime' ? 15 : 5;
  if (mcqState[sec].includes(idx)) { showToast('Already selected',true); return; }
  if (mcqState[sec].length >= max) { showToast(`Max ${max} questions — clear one first`,true); return; }
  mcqState[sec].push(idx);
  renderMCQSlots(sec, max);
  renderMCQBank(sec);
  updateReadiness();
}

function mcqClearSlot(sec, i) {
  const max = sec==='crime' ? 15 : 5;
  mcqState[sec].splice(i, 1);
  renderMCQSlots(sec, max);
  renderMCQBank(sec);
  updateReadiness();
}

function mcqPick(sec) {
  const max = sec==='crime' ? 15 : 5;
  if (mcqState[sec].length >= max) { showToast('All slots filled — clear one first', true); return; }
  const topic = sec==='crime' ? document.getElementById('crimeTopicPicker').value : '';
  const pool = MCQ_DATA.map((q,i)=>({q,i})).filter(({q,i})=>{
    if (mcqState[sec].includes(i)) return false;
    if (sec==='hr') return q['Syllabus point']==='Human Rights';
    if (topic) return q['Syllabus point']===topic;
    return q['Syllabus point']!=='Human Rights';
  });
  if (!pool.length) { showToast('No more questions available',true); return; }
  const pick = pool[Math.floor(Math.random()*pool.length)];
  mcqState[sec].push(pick.i);
  renderMCQSlots(sec, max);
  renderMCQBank(sec);
  updateReadiness();
}

function mcqShuffle(sec) {
  const max = sec==='crime' ? 15 : 5;
  const pool = MCQ_DATA.map((q,i)=>({q,i})).filter(({q})=>
    sec==='hr' ? q['Syllabus point']==='Human Rights' : q['Syllabus point']!=='Human Rights'
  ).sort(()=>Math.random()-.5);
  // Pick spread across topics for crime
  if (sec==='crime') {
    const picked=[], usedT=new Set();
    for (const {q,i} of pool) { if(picked.length>=max) break; if(!usedT.has(q['Syllabus point'])){picked.push(i);usedT.add(q['Syllabus point']);} }
    for (const {q,i} of pool) { if(picked.length>=max) break; if(!picked.includes(i)) picked.push(i); }
    mcqState[sec] = picked.slice(0,max);
  } else {
    mcqState[sec] = pool.slice(0,max).map(x=>x.i);
  }
  renderMCQSlots(sec, max);
  renderMCQBank(sec);
  updateReadiness();
}

// ── SHORT ANSWER ──────────────────────────────────────────────────────────────
function saTotal() { return saState.reduce((s,i)=>s+SA_DATA[i].marks, 0); }
function saCount() { return saState.length; }

function saCombHints() {
  // Show a few valid combos
  const avail = [...new Set(SA_DATA.map(r=>r.marks))].sort((a,b)=>a-b);
  const combos=[];
  for(let n=3;n<=5;n++){
    (function pick(rem,min,path){
      if(path.length===n){ if(rem===0) combos.push([...path]); return; }
      if(path.length>n||rem<0) return;
      for(const m of avail){ if(m<min) continue; pick(rem-m,m,[...path,m]); }
    })(15,avail[0],[]);
  }
  return combos.slice(0,12).map(c=>`${c.join(' + ')} = 15 (${c.length} questions)`).join('<br>');
}

function initSA() {
  document.getElementById('combHints').innerHTML = saCombHints();
  renderSASlots();
  renderSABank();
  saShuffle();
}

function renderSASlots() {
  const container = document.getElementById('saSlots');
  container.innerHTML = saState.map((idx,i)=>{
    const item = SA_DATA[idx];
    return `<div class="q-slot">
      <div class="slot-lbl sa">Q${i+1} &middot; ${item.marks} mark${item.marks>1?'s':''}</div>
      <div class="slot-txt">${item.q}</div>
      <button class="slot-clear" onclick="saClearSlot(${i})">&#x2715;</button>
    </div>`;
  }).join('') + (saState.length===0?`<div class="q-slot"><div class="slot-txt empty">No questions selected</div></div>`:'');
  updateSATotal();
}

function renderSABank() {
  const taken = new Set(saState);
  document.getElementById('saBank').innerHTML = SA_DATA.map((item,i)=>`
    <div class="bank-item ${taken.has(i)?'taken':''}" onclick="saSelect(${i})">
      <div class="bank-cat sa">${item.marks} mark${item.marks>1?'s':''}</div>
      <div>${item.q}</div>
    </div>`).join('');
}

function saSelect(idx) {
  if (saState.includes(idx)) { showToast('Already selected',true); return; }
  if (saCount()>=5) { showToast('Max 5 questions — clear one first',true); return; }
  const tot = saTotal() + SA_DATA[idx].marks;
  if (tot>15) { showToast(`Adding this would exceed 15 marks (would be ${tot})`,true); return; }
  saState.push(idx);
  renderSASlots(); renderSABank(); updateReadiness();
}

function saClearSlot(i) {
  saState.splice(i,1);
  renderSASlots(); renderSABank(); updateReadiness();
}

function saPick() {
  if (saCount()>=5) { showToast('Max 5 questions',true); return; }
  const rem = 15 - saTotal();
  if (rem<=0) { showToast('Already at 15 marks — clear a question first',true); return; }
  const markFilter = document.getElementById('saMarkPicker').value;
  const taken = new Set(saState);
  let pool = SA_DATA.map((item,i)=>({item,i})).filter(({item,i})=>{
    if (taken.has(i)) return false;
    if (markFilter) return item.marks===parseInt(markFilter) && item.marks<=rem;
    return item.marks<=rem;
  });
  if (!pool.length) { showToast('No suitable questions available',true); return; }
  const pick = pool[Math.floor(Math.random()*pool.length)];
  saState.push(pick.i);
  renderSASlots(); renderSABank(); updateReadiness();
}

function saShuffle() {
  saState.length=0;
  // Pick a random valid combo
  const avail = [...new Set(SA_DATA.map(r=>r.marks))].sort((a,b)=>a-b);
  const combos=[];
  for(let n=3;n<=5;n++){
    (function pick(rem,min,path){
      if(path.length===n){ if(rem===0) combos.push([...path]); return; }
      if(path.length>n||rem<0) return;
      for(const m of avail){ if(m<min) continue; pick(rem-m,m,[...path,m]); }
    })(15,avail[0],[]);
  }
  if(!combos.length) return;
  const combo = combos[Math.floor(Math.random()*combos.length)];
  const used = new Set();
  for (const marks of combo) {
    const pool = SA_DATA.map((item,i)=>({item,i})).filter(({item,i})=>item.marks===marks && !used.has(i));
    if (!pool.length) { saState.length=0; renderSASlots(); renderSABank(); updateReadiness(); return; }
    const pick = pool[Math.floor(Math.random()*pool.length)];
    saState.push(pick.i);
    used.add(pick.i);
  }
  renderSASlots(); renderSABank(); updateReadiness();
}

function updateSATotal() {
  const tot = saTotal(), n = saCount();
  const pct = (tot/15)*100;
  const fill = document.getElementById('saTotalFill');
  fill.style.width = Math.min(pct,100)+'%';
  fill.style.background = tot===15 ? '#22c55e' : tot>15 ? '#ef4444' : 'var(--sa)';
  document.getElementById('saTotalLabel').textContent = `${tot} / 15 marks`;
  const msg = document.getElementById('saStatusMsg');
  if (tot===15 && n>=3 && n<=5) msg.textContent = `✓ Valid — ${n} questions`;
  else if (tot>15) msg.textContent = `Over limit by ${tot-15} marks`;
  else msg.textContent = `${15-tot} marks remaining (${n} questions)`;
}

// ── ESSAYS ────────────────────────────────────────────────────────────────────
function initEssays() {
  ['crime','work','world'].forEach(sec=>{
    const qs = BANK[ESSAY_KEY[sec]];
    const cats = [...new Set(qs.map(q=>q.cat))];
    const sel = document.getElementById(sec+'Cat');
    cats.forEach(c=>{ const o=document.createElement('option'); o.value=o.textContent=c; sel.appendChild(o); });
    renderEssayBank(sec);
    essayShuffle(sec);
  });
}

function renderEssayBank(sec) {
  const qs = BANK[ESSAY_KEY[sec]];
  const taken = new Set(essayState[sec].filter(Boolean).map(q=>q&&q.q));
  document.getElementById(sec+'EssayBank').innerHTML = qs.map((item,i)=>`
    <div class="bank-item ${taken.has(item.q)?'taken':''}" onclick="essaySelectFromBank('${sec}',${i})">
      <div class="bank-cat ${sec}">${item.cat}</div>
      <div>${item.q}</div>
    </div>`).join('');
}

function refreshEssay(sec) {
  const slots = essayState[sec];
  slots.forEach((item,i)=>{
    const el=document.getElementById(sec+'T'+i);
    el.textContent=item?item.q:'No question selected';
    el.className='slot-txt'+(item?'':' empty');
  });
  renderEssayBank(sec);
  updateReadiness();
}

function essaySelectFromBank(sec, idx) {
  const item = BANK[ESSAY_KEY[sec]][idx];
  if (essayState[sec].some(s=>s&&s.q===item.q)) { showToast('Already selected',true); return; }
  const empty = essayState[sec].findIndex(s=>s===null);
  if (empty===-1) { showToast(`Max ${ESSAY_SLOTS[sec]} question${ESSAY_SLOTS[sec]>1?'s':''} — clear one first`,true); return; }
  essayState[sec][empty]=item;
  refreshEssay(sec);
}

function essayPick(sec) {
  const cat = document.getElementById(sec+'Cat').value;
  let pool = BANK[ESSAY_KEY[sec]];
  if (cat) pool = pool.filter(q=>q.cat===cat);
  const taken = new Set(essayState[sec].filter(Boolean).map(q=>q.q));
  const avail = pool.filter(q=>!taken.has(q.q));
  const empty = essayState[sec].findIndex(s=>s===null);
  if (empty===-1) { showToast('Clear a slot first',true); return; }
  if (!avail.length) { showToast('No more questions in this category',true); return; }
  essayState[sec][empty]=avail[Math.floor(Math.random()*avail.length)];
  refreshEssay(sec);
}

function essayClear(sec,i) { essayState[sec][i]=null; refreshEssay(sec); }

function essayShuffle(sec) {
  essayState[sec]=essayState[sec].map(()=>null);
  const pool=[...BANK[ESSAY_KEY[sec]]].sort(()=>Math.random()-.5);
  const n=ESSAY_SLOTS[sec]; const picked=[],usedCats=new Set();
  for(const item of pool){if(picked.length>=n)break;if(!usedCats.has(item.cat)){picked.push(item);usedCats.add(item.cat);}}
  for(const item of pool){if(picked.length>=n)break;if(!picked.find(p=>p.q===item.q))picked.push(item);}
  essayState[sec]=picked.slice(0,n);
  refreshEssay(sec);
}

// ── READINESS + PREVIEW ───────────────────────────────────────────────────────
function updateReadiness() {
  const mcqOk  = mcqState.crime.length===15 && mcqState.hr.length===5;
  const saOk   = saCount()>=3 && saCount()<=5 && saTotal()===15;
  const crimeOk= essayState.crime[0]!==null;
  const workOk = essayState.work[0]!==null && essayState.work[1]!==null;
  const worldOk= essayState.world[0]!==null && essayState.world[1]!==null;

  ['MCQ','SA','Crime','Work','World'].forEach((k,idx)=>{
    const ok=[mcqOk,saOk,crimeOk,workOk,worldOk][idx];
    document.getElementById('d'+k).className='dot '+(ok?'on':'off');
  });

  const allOk = mcqOk&&saOk&&crimeOk&&workOk&&worldOk;
  document.getElementById('genBtn').disabled = !allOk;
  document.getElementById('ansBtn').disabled = !mcqOk;

  updatePreview();
}

