// ── PDF: PAPER ────────────────────────────────────────────────────────────────
function generatePaper() {
  const first = buildPaper(0);              // pass 1: find out where Section I ends
  const final = buildPaper(first.mcqEnd);   // pass 2: print the real page range on the cover
  final.doc.save('HSC_Legal_Studies_Paper.pdf');
  showToast('Paper downloaded!');
}

function buildPaper(mcqEnd) {
  const {jsPDF}=window.jspdf;
  const doc=new jsPDF({unit:'mm',format:'a4'});
  const W=210, H=297, ml=20, mr=20, cw=170;
  let y=0;

  const title   = document.getElementById('examTitle').value||'Trial HSC Examination';
  const subj    = document.getElementById('subject').value||'Legal Studies';
  const crimeQN = parseInt(document.getElementById('crimeQN').value)||21;
  const workQN  = parseInt(document.getElementById('workQN').value)||22;
  const worldQN = parseInt(document.getElementById('worldQN').value)||23;

  const INK=[0,0,0], GRAY=[120,120,120];
  const LH = 12*0.3528*1.35;        // normal text line height (mm) for 12pt
  const ANS_LH = 12*0.3528*2;       // double-spaced answer lines (24pt) in mm
  // Answer lines per question: 2 + 2 x marks for 1-5 marks, 3 x marks for 6+ marks
  const answerLines = m => (m <= 5 ? 2 + 2*m : 3*m);
  let mcqEndPage = 0;

  // ── Helpers ────────────────────────────────────────────────────────────────
  function newPage(){ doc.addPage(); y=22; }

  function pageHeader(left, right){
    doc.setFont('times','normal'); doc.setFontSize(12); doc.setTextColor(...GRAY);
    if(left)  doc.text(left,  ml,    10);
    if(right) doc.text(right, W-mr,  10, {align:'right'});
    doc.setDrawColor(...GRAY); doc.setLineWidth(0.3);
    doc.line(ml, 13, W-mr, 13);
  }

  function sp(mm=4){ y+=mm; }

  // Plain text block – uses helvetica to avoid symbol-mangling
  function t(str, opts={}){
    const{size=12,bold=false,italic=false,center=false,color=INK,indent=0,font='times'}=opts;
    doc.setFontSize(size); doc.setTextColor(...color);
    doc.setFont(font, bold&&italic?'bolditalic':bold?'bold':italic?'italic':'normal');
    const w = cw - indent;
    const xPos = center ? W/2 : ml+indent;
    const lines = doc.splitTextToSize(str, w);
    const lh = LH;
    if(y + lines.length*lh > H-16){ newPage(); }
    doc.text(lines, xPos, y, {align:center?'center':'left'});
    y += lines.length * lh;
  }

  // Times text block (for question body text and essay questions)
  function tt(str, opts={}){
    return t(str, Object.assign({font:'times'}, opts));
  }

  function rule(thick=false){
    doc.setDrawColor(0); doc.setLineWidth(thick?0.6:0.3);
    doc.line(ml, y, W-mr, y); y += thick?5:3;
  }

  function blankLine(){
    doc.setDrawColor(150,150,150); doc.setLineWidth(0.2);
    doc.line(ml, y, W-mr, y); y += ANS_LH;
  }

  // Bullet point using simple hyphen-dash to avoid encoding issues
  function bullet(str, indent=8){
    t('- ' + str, {size:12, indent});
  }

  // ── COVER PAGE ─────────────────────────────────────────────────────────────
  y = 25;

  // Top row: Centre Number / Student Number labels (no NESA name)
  doc.setFont('times','normal'); doc.setFontSize(12); doc.setTextColor(...INK);
  doc.text('Centre Number', ml, y);
  doc.text('Student Number', ml+80, y);
  y += 6;

  // Input boxes
  doc.setDrawColor(0); doc.setLineWidth(0.4);
  const BOX = 8;
  for(let i=0;i<5;i++) doc.rect(ml + i*BOX,      y, BOX, BOX);
  for(let i=0;i<9;i++) doc.rect(ml + 80 + i*BOX, y, BOX, BOX);
  y += 16;

  // Title block — Arial (helvetica in jsPDF) as requested
  doc.setFont('times','bold'); doc.setFontSize(15); doc.setTextColor(...INK);
  doc.text(title.toUpperCase(), W/2, y, {align:'center'});
  y += 8;
  doc.setFontSize(22);
  doc.text(subj, W/2, y, {align:'center'});
  y += 12;

  rule(true); sp(4);

  // General Instructions — two-column style matching real papers
  doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
  const giLabelX = ml, giTextX = ml+42;
  doc.text('General', giLabelX, y);
  doc.text('Instructions', giLabelX, y+5);
  const gi = [
    'Reading time - 5 minutes',
    'Working time - 3 hours',
    'Write using black pen',
    'Write your Centre Number and Student Number at the top of this page',
  ];
  doc.setFont('times','normal'); doc.setFontSize(12);
  gi.forEach(line => {
    const lines = doc.splitTextToSize('- ' + line, cw - 42);
    doc.text(lines, giTextX, y);
    y += lines.length * LH;
  });
  sp(5); rule(); sp(4);

  // Total marks
  doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
  doc.text('Total marks: 100', W/2, y, {align:'center'});
  sp(7);

  // Section summaries
  const saCount_ = saState.length;
  const saLast = 21 + saCount_ - 1;
  const secs = [
    { hd: `Section I - 20 marks` + (mcqEnd ? ` (pages 2-${mcqEnd})` : ''),
      lines: ['- Attempt Questions 1-20','- Allow about 30 minutes for this section'] },
    { hd: 'Section II - 30 marks',
      lines: ['This section has two parts, Part A and Part B',
              '- Allow about 1 hour for this section',
              'Part A - 15 marks',
              `- Attempt Questions 21-${saLast}`,
              'Part B - 15 marks',
              `- Attempt Question ${crimeQN}`] },
    { hd: 'Section III - 50 marks',
      lines: [`- Attempt TWO questions from Questions ${workQN}-${worldQN}, each from a different Option`,
              '- Allow about 1 hour and 30 minutes for this section'] },
  ];

  secs.forEach(sec => {
    doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
    const hdLines = doc.splitTextToSize(sec.hd, cw);
    doc.text(hdLines, ml, y);
    y += hdLines.length * LH;
    doc.setFont('times','normal');
    sec.lines.forEach(l => {
      const ll = doc.splitTextToSize(l, cw-8);
      doc.text(ll, ml+8, y);
      y += ll.length * LH;
    });
    sp(4);
  });

  // ── SECTION I - MCQ ────────────────────────────────────────────────────────
  newPage();
  pageHeader('Section I', subj + ' - ' + title);

  // Plain text section header block (no grey box)
  doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
  doc.text('Section I', ml, y); y += 6;
  doc.setFont('times','normal'); doc.setFontSize(12);
  doc.text('20 marks', ml, y); y += 6;
  doc.text('Attempt Questions 1-20', ml, y); y += 6;
  doc.text('Allow about 30 minutes for this section', ml, y); y += 6;
  doc.text('Use the multiple-choice answer sheet for Questions 1-20.', ml, y); y += 6;
  sp(3); rule(); sp(4);

  const allMCQ = getPaperMCQOrder();

  allMCQ.forEach((q, n) => {
    // Estimate space needed for this question
    const qLines_ = doc.splitTextToSize(q['Question'], cw-12);
    const optHeights = ['A','B','C','D'].map(o => {
      const ol = doc.splitTextToSize(q[o], cw-26);
      return ol.length * LH;
    });
    const needed = qLines_.length * LH + optHeights.reduce((a,b)=>a+b,0) + 14;
    if(y + needed > H-16){ newPage(); pageHeader('Section I (continued)', subj+' - '+title); }

    const qNum = n+1;
    doc.setFont('times','normal'); doc.setFontSize(12); doc.setTextColor(...INK);
    const qLines = doc.splitTextToSize(q['Question'], cw-12);
    doc.text(String(qNum), ml, y);
    doc.text(qLines, ml+12, y);
    y += qLines.length * LH + 2;

    // Options A-D — use helvetica to prevent symbol corruption
    ['A','B','C','D'].forEach(opt => {
      doc.setFont('times','normal'); doc.setFontSize(12); doc.setTextColor(...INK);
      const optLines = doc.splitTextToSize(q[opt]||'', cw-30);
      doc.text('(' + opt + ')', ml+12, y);
      doc.text(optLines, ml+26, y);
      y += optLines.length * LH;
    });
    sp(5);
  });

  rule(); sp(3);
  t('End of Section I', {size:12, bold:true, center:true});
  mcqEndPage = doc.getNumberOfPages();

  // ── SECTION II PART A — SHORT ANSWER ──────────────────────────────────────
  newPage();
  pageHeader('Section II - Part A', subj+' - '+title);

  doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
  doc.text('Section II', ml, y); y += 6;
  doc.setFont('times','normal'); doc.setFontSize(12);
  doc.text('30 marks', ml, y); y += 6;
  sp(2);
  doc.setFont('times','bold'); doc.setFontSize(12);
  doc.text('Part A - Human Rights', ml, y); y += 6;
  doc.setFont('times','normal');
  doc.text('15 marks', ml, y); y += 6;
  doc.text(`Attempt Questions 21-${saLast}`, ml, y); y += 6;
  sp(2);
  doc.setFont('times','italic'); doc.setFontSize(12);
  const saInstr = doc.splitTextToSize('Answer the questions in the spaces provided. These spaces provide guidance for the expected length of response.', cw);
  doc.text(saInstr, ml, y);
  y += saInstr.length * LH + 4;
  rule(true); sp(4);

  saState.forEach((idx, n) => {
    const item = SA_DATA[idx];
    const qNum = 21 + n;
    const nLines = answerLines(item.marks);
    const hdrPage = () => { newPage(); pageHeader('Section II - Part A (continued)', subj+' - '+title); };

    doc.setFont('times','normal'); doc.setFontSize(12);
    const qLines_ = doc.splitTextToSize(item.q, cw);
    const textH = 7 + qLines_.length * LH + 3;
    const blockH = textH + nLines * ANS_LH + 5;
    const usable = (H-16) - 22;
    // keep the whole question on one page where it fits; otherwise keep at least 3 lines with it
    const needed_ = blockH <= usable ? blockH : textH + 3 * ANS_LH;
    if(y + needed_ > H-16) hdrPage();

    doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
    doc.text('Question ' + qNum, ml, y);
    doc.text('(' + item.marks + ' mark' + (item.marks>1?'s':'') + ')', W-mr, y, {align:'right'});
    y += 7;

    doc.setFont('times','normal'); doc.setFontSize(12);
    doc.text(qLines_, ml, y);
    y += qLines_.length * LH + 3;

    for(let i=0; i<nLines; i++){
      if(y + ANS_LH > H-16) hdrPage();
      blankLine();
    }
    sp(5);
  });

  t('End of Section II Part A', {size:12, bold:true, center:true}); sp(3);
  t('Turn over for Section II Part B', {size:12, italic:true, center:true});

  // ── BLANK PAGE ─────────────────────────────────────────────────────────────
  newPage();
  pageHeader('', subj+' - '+title);
  doc.setFont('times','italic'); doc.setFontSize(12); doc.setTextColor(...GRAY);
  doc.text('BLANK PAGE', W/2, H/2, {align:'center'});

  // ── SECTION II PART B — CRIME ──────────────────────────────────────────────
  newPage();
  pageHeader('Section II - Part B', subj+' - '+title);

  doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
  doc.text('Section II (continued)', ml, y); y += 6;
  doc.setFont('times','bold'); doc.setFontSize(12);
  doc.text('Part B - Crime', ml, y); y += 6;
  doc.setFont('times','normal');
  doc.text('15 marks', ml, y); y += 6;
  doc.text('Attempt Question ' + crimeQN, ml, y); y += 6;
  sp(2);
  doc.setFont('times','italic'); doc.setFontSize(12);
  doc.text('Answer the question in the Section II Answer Booklet. Extra writing booklets are available.', ml, y);
  y += LH + 3;
  sp(2);
  doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
  doc.text('Your answer will be assessed on how well you:', ml, y); y += 6;
  doc.setFont('times','normal');
  [
    'demonstrate knowledge and understanding of legal issues relevant to the question',
    'communicate using relevant legal terminology and concepts',
    'refer to relevant examples such as legislation, cases, media reports and other documents',
    'present a sustained, logical and cohesive response',
  ].forEach(c => {
    const cl = doc.splitTextToSize('- ' + c, cw-10);
    doc.text(cl, ml+8, y);
    y += cl.length * LH;
  });
  sp(4); rule(true); sp(4);

  doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
  doc.text('Question ' + crimeQN, ml, y);
  doc.text('(15 marks)', W-mr, y, {align:'right'});
  y += 7;
  doc.setFont('times','normal'); doc.setFontSize(12);
  const crimeLines_ = doc.splitTextToSize(essayState.crime[0].q, cw);
  doc.text(crimeLines_, ml, y);
  y += crimeLines_.length * LH;
  sp(8); rule(); sp(4);
  t('End of Section II', {size:12, bold:true, center:true});

  // ── BLANK PAGE ─────────────────────────────────────────────────────────────
  newPage();
  pageHeader('', subj+' - '+title);
  doc.setFont('times','italic'); doc.setFontSize(12); doc.setTextColor(...GRAY);
  doc.text('BLANK PAGE', W/2, H/2, {align:'center'});

  // ── SECTION III — OPTIONS ──────────────────────────────────────────────────
  newPage();
  pageHeader('Section III', subj+' - '+title);

  doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
  doc.text('Section III - Options', ml, y); y += 6;
  doc.setFont('times','normal'); doc.setFontSize(12);
  doc.text('50 marks', ml, y); y += 6;
  const attemptLine = doc.splitTextToSize(
    'Attempt TWO questions from Questions ' + workQN + '-' + worldQN + ', each from a different Option', cw);
  doc.text(attemptLine, ml, y);
  y += attemptLine.length * LH;
  doc.text('Allow about 1 hour and 30 minutes for this section', ml, y); y += 6;
  sp(2);
  doc.setFont('times','italic');
  doc.text('Answer both questions in the Section III Writing Booklet. Extra writing booklets are available.', ml, y);
  y += LH + 3;
  sp(2);
  doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
  doc.text('Your answers will be assessed on how well you:', ml, y); y += 6;
  doc.setFont('times','normal');
  [
    'demonstrate knowledge and understanding of legal issues relevant to the question',
    'communicate using relevant legal terminology and concepts',
    'refer to relevant examples such as legislation, cases, media, international instruments and documents',
    'present a sustained, logical and cohesive response',
  ].forEach(c => {
    const cl = doc.splitTextToSize('- ' + c, cw-10);
    doc.text(cl, ml+8, y);
    y += cl.length * LH;
  });
  sp(4); rule(true); sp(4);

  // Helper: essay question block
  function essayQ(qLabel, aText, bText) {
    const needed = 60;
    if(y + needed > H-16){ newPage(); pageHeader('Section III (continued)', subj+' - '+title); }

    doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
    doc.text(qLabel, ml, y);
    doc.text('(25 marks)', W-mr, y, {align:'right'});
    y += 7;

    doc.setFont('times','normal'); doc.setFontSize(12);
    const aLines = doc.splitTextToSize('(a)  ' + aText, cw);
    doc.text(aLines, ml, y);
    y += aLines.length * LH;

    // Mark right-aligned per NESA style
    doc.setFont('times','normal'); doc.setFontSize(12);
    doc.text('25', W-mr, y, {align:'right'});
    sp(3);

    doc.setFont('times','bold'); doc.setFontSize(12); doc.setTextColor(...INK);
    doc.text('OR', W/2, y, {align:'center'}); y += 7;

    doc.setFont('times','normal'); doc.setFontSize(12);
    const bLines = doc.splitTextToSize('(b)  ' + bText, cw);
    doc.text(bLines, ml, y);
    y += bLines.length * LH;

    doc.setFont('times','normal'); doc.setFontSize(12);
    doc.text('25', W-mr, y, {align:'right'});
    sp(6); rule(); sp(4);
  }

  essayQ('Question ' + workQN  + ' - Workplace',  essayState.work[0].q,  essayState.work[1].q);
  essayQ('Question ' + worldQN + ' - World Order', essayState.world[0].q, essayState.world[1].q);

  t('End of paper', {size:12, bold:true, center:true});

  // ── PAGE FOOTERS ───────────────────────────────────────────────────────────
  const pg = doc.getNumberOfPages();
  for(let p=1; p<=pg; p++){
    doc.setPage(p);
    doc.setFontSize(12); doc.setFont('times','normal'); doc.setTextColor(...GRAY);
    doc.text('- ' + p + ' -', W/2, H-8, {align:'center'});
  }

  return { doc, mcqEnd: mcqEndPage };
}

// helper used in cover page section count
function allMCQCount(){ return 20; }

// ── SHARED MCQ ORDER ──────────────────────────────────────────────────────────
// The paper and the answer key both call this, so question numbers always match.
// The order is shuffled once per set of selected questions and then reused.
let paperOrder = null, paperOrderSig = '';
function getPaperMCQOrder() {
  const ids = [...mcqState.crime, ...mcqState.hr];
  const sig = ids.slice().sort((a,b)=>a-b).join(',');
  if (!paperOrder || paperOrderSig !== sig) {
    const a = ids.slice();
    for (let i=a.length-1; i>0; i--) {
      const j = Math.floor(Math.random()*(i+1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    paperOrder = a;
    paperOrderSig = sig;
  }
  return paperOrder.map(i => MCQ_DATA[i]);
}



// ── PDF: ANSWERS ──────────────────────────────────────────────────────────────
function generateAnswers() {
  const {jsPDF}=window.jspdf;
  const doc=new jsPDF({unit:'mm',format:'a4'});
  const W=210,ml=25,mr=25,cw=160;
  let y=22;
  const MCQ_C=[92,62,139],INK=[15,14,13],MU=[122,112,96];

  const title=document.getElementById('examTitle').value||'Trial HSC Examination';
  const subj =document.getElementById('subject').value||'Legal Studies';

  function t(str,opts={}){
    const{size=12,bold=false,center=false,color=INK,indent=0}=opts;
    doc.setFontSize(size);doc.setTextColor(...color);
    doc.setFont('times',bold?'bold':'normal');
    const lines=doc.splitTextToSize(str,cw-indent);
    doc.text(lines,center?W/2:ml+indent,y,{align:center?'center':'left'});
    y+=lines.length*size*.3528*1.45;
  }
  function rule(){doc.setDrawColor(...MCQ_C);doc.setLineWidth(.3);doc.line(ml,y,W-mr,y);y+=4;}
  function sp(mm=4){y+=mm;}

  t('Multiple Choice Answer Key',{size:16,bold:true,center:true,color:MCQ_C});sp(2);
  t(`${title} – ${subj}`,{size:11,center:true,color:MU});sp(4);
  rule();sp(2);

  // Same order as the paper, so Q1 here is Q1 on the paper
  const shuffled=getPaperMCQOrder();
  const cols=4, rowH=8, colW=cw/cols;
  shuffled.forEach((q,n)=>{
    const col=n%cols, row=Math.floor(n/cols);
    const x=ml+col*colW, yy=y+row*rowH;
    doc.setFontSize(10);doc.setFont('times','normal');doc.setTextColor(...INK);
    doc.text(`${n+1}.  ${q['Answer']}   [${q['Code']}]`,x,yy);
  });
  y+=Math.ceil(shuffled.length/cols)*rowH+8;
  rule();sp(4);
  t('Question numbers match the paper generated from the same selections. Codes in [ ] match the Google Sheet.',{size:9,center:true,color:MU});

  const pg=doc.getNumberOfPages();
  for(let p=1;p<=pg;p++){
    doc.setPage(p);doc.setFontSize(8);doc.setFont('times','normal');doc.setTextColor(...MU);
    doc.text(`Page ${p} of ${pg}`,W/2,297-8,{align:'center'});
  }
  doc.save('HSC_Legal_Studies_Answers.pdf');
  showToast('Answer sheet downloaded!');
}

// ── INIT ──────────────────────────────────────────────────────────────────────
// ── LOAD QUESTIONS FROM GOOGLE SHEET ──────────────────────────────────────────
// Paste the "Publish to web" CSV link for each tab between the quotes.
// Leave a link empty (or if it fails to load) and the built-in questions are used.
const SHEET_URLS = {
  mcq:     '',   // MCQ tab
  sa:      '',   // Short Answer tab
  essays:  ''    // Essays tab
};

function parseCSV(text) {
  text = text.replace(/^﻿/, '');
  const rows = []; let row = [], cell = '', inQ = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (inQ) {
      if (c === '"') { if (text[i+1] === '"') { cell += '"'; i++; } else inQ = false; }
      else cell += c;
    } else if (c === '"') inQ = true;
    else if (c === ',') { row.push(cell); cell = ''; }
    else if (c === '\n' || c === '\r') {
      if (c === '\r' && text[i+1] === '\n') i++;
      row.push(cell); cell = ''; rows.push(row); row = [];
    } else cell += c;
  }
  if (cell !== '' || row.length) { row.push(cell); rows.push(row); }
  return rows.filter(r => r.some(v => v.trim() !== ''));
}

async function fetchTable(url) {
  const res = await fetch(url, { cache: 'no-store' });
  if (!res.ok) throw new Error('HTTP ' + res.status);
  const rows = parseCSV(await res.text());
  if (rows.length < 2) return [];
  const hdr = rows[0].map(h => h.trim().toLowerCase());
  return rows.slice(1).map(r => {
    const o = {}; hdr.forEach((h, i) => { o[h] = (r[i] || '').trim(); }); return o;
  });
}

async function loadFromSheet() {
  const got = [];
  if (SHEET_URLS.mcq) try {
    const t = await fetchTable(SHEET_URLS.mcq);
    const d = t.filter(r => r['question'] && r['a'] && r['b'] && r['c'] && r['d'] && /^[ABCD]$/i.test(r['answer']))
      .map((r, i) => ({ 'Syllabus point': r['syllabus point'] || 'Nature of crime', 'Question': r['question'],
        A: r['a'], B: r['b'], C: r['c'], D: r['d'], Code: r['code'] || ('X' + (i+1)), Answer: r['answer'].toUpperCase() }));
    if (d.length) { MCQ_DATA = d; got.push(d.length + ' MCQ'); }
  } catch (e) { console.warn('MCQ sheet failed', e); }
  if (SHEET_URLS.sa) try {
    const t = await fetchTable(SHEET_URLS.sa);
    const d = t.filter(r => r['q'] && parseInt(r['marks']) > 0).map(r => ({ marks: parseInt(r['marks']), q: r['q'] }));
    if (d.length) { SA_DATA = d; got.push(d.length + ' short answer'); }
  } catch (e) { console.warn('SA sheet failed', e); }
  if (SHEET_URLS.essays) try {
    const t = await fetchTable(SHEET_URLS.essays);
    const nb = { 'Crime': [], 'Workplace': [], 'World Order': [] };
    t.forEach(r => {
      const key = Object.keys(nb).find(k => k.toLowerCase() === (r['section'] || '').toLowerCase());
      if (key && r['q']) nb[key].push({ cat: r['cat'] || 'General', q: r['q'] });
    });
    if (nb['Crime'].length && nb['Workplace'].length && nb['World Order'].length) {
      BANK = nb; got.push('essays');
    }
  } catch (e) { console.warn('Essay sheet failed', e); }
  CRIME_TOPICS = [...new Set(MCQ_DATA.filter(q => q['Syllabus point'] !== 'Human Rights').map(q => q['Syllabus point']))];
  return got;
}

(async function boot() {
  let got = [];
  try { got = await loadFromSheet(); } catch (e) { console.warn(e); }
  initMCQ();
  initSA();
  initEssays();
  updateReadiness();
  if (SHEET_URLS.mcq || SHEET_URLS.sa || SHEET_URLS.essays) {
    if (got.length) showToast('Loaded from Google Sheet: ' + got.join(', '));
    else showToast('Could not load the Google Sheet - using built-in questions', true);
  }
})();
